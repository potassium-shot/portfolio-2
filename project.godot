; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Portfolio 2"
run/main_scene="uid://cf6kyaftmp07q"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://audio/": "purple",
"res://resources/": "yellow",
"res://scenes/": "orange",
"res://scripts/": "blue",
"res://shaders/": "pink",
"res://textures/": "red"
}

[gui]

common/auto_focus_strategy=1

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/multi_bounce_occlusion/enabled=true
environment/defaults/default_clear_color=Color(0.021434618, 0.02143464, 0.021434633, 1)
